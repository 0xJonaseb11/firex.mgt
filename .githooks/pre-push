#!/bin/sh
# Only allow pushes from the configured maintainer identity.
expected_name="0xJonaseb11"
expected_email="sebejaz99@gmail.com"

# Reject pushes that include .env files (except .env.example).
check_push_for_env() {
	local local_sha="$1"
	local remote_sha="$2"
	local range

	if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
		return 0
	fi

	if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
		range="$local_sha"
	else
		range="${remote_sha}..${local_sha}"
	fi

	blocked=$(
		git diff --name-only "$range" 2>/dev/null |
			grep -E '(^|/)\.env$|(^|/)\.env\.[^/]+$|\.env\.local$' |
			grep -vE '\.env\.example$' || true
	)

	if [ -n "$blocked" ]; then
		echo "Push blocked: .env files must not be pushed." >&2
		echo "$blocked" | sed 's/^/  /' >&2
		exit 1
	fi
}

while read -r local_ref local_sha remote_ref remote_sha; do
	check_push_for_env "$local_sha" "$remote_sha"
done

name=$(git config --get user.name)
email=$(git config --get user.email)

if [ "$name" != "$expected_name" ] || [ "$email" != "$expected_email" ]; then
  echo "Push blocked: this repo is locked to $expected_name <$expected_email>." >&2
  echo "Current identity: ${name:-<unset>} <${email:-<unset>}>" >&2
  exit 1
fi

remote="${1:-origin}"
url=$(git remote get-url "$remote" 2>/dev/null) || exit 0
case "$url" in
  git@github.com:0xJonaseb11/*|git@github.com-0xjonaseb11:0xJonaseb11/*) ;;
  *)
    echo "Push blocked: remote must use SSH for 0xJonaseb11 on GitHub." >&2
    echo "Expected: git@github.com:0xJonaseb11/<repo>.git" >&2
    echo "Got: $url" >&2
    exit 1
    ;;
esac

exit 0
