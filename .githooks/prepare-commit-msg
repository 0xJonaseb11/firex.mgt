#!/bin/sh
# Remove Cursor/agent attribution lines from commit messages.
commit_msg_file=$1
[ -f "$commit_msg_file" ] || exit 0

tmp="${commit_msg_file}.strip"
grep -viE '(^co-authored-by:.*cursor)|(^made-with:.*cursor)|cursoragent@cursor\.com' "$commit_msg_file" >"$tmp" || exit 0
mv "$tmp" "$commit_msg_file"
