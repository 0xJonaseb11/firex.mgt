#!/bin/sh
# Block committing real env files; .env.example is allowed.
blocked=$(
	git diff --cached --name-only --diff-filter=ACMR |
		grep -E '(^|/)\.env$|(^|/)\.env\.[^/]+$|\.env\.local$' |
		grep -vE '\.env\.example$' || true
)

if [ -n "$blocked" ]; then
	echo "Commit blocked: .env files must not be committed." >&2
	echo "$blocked" | sed 's/^/  /' >&2
	echo "Use apps/api/.env.example as a template; keep secrets in apps/api/.env locally." >&2
	exit 1
fi

exit 0
