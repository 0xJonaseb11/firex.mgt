PORT=8080
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# --- Option A: Supabase (recommended for this project) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Database password from Supabase Dashboard → Project Settings → Database
SUPABASE_DB_PASSWORD=your-database-password
# Host from Connect → Direct → Session pooler (IPv4-friendly on Windows)
SUPABASE_POOLER_HOST=aws-0-eu-west-1.pooler.supabase.com

# Optional: paste full session pooler URI instead of SUPABASE_DB_PASSWORD + SUPABASE_POOLER_HOST
# DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# DATABASE_URL_DIRECT=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# On Windows, if direct db.*.supabase.co fails, use Session pooler URI from Dashboard → Connect

# --- Option B: Local Postgres ---
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/tzw_fire
# DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/tzw_fire

ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
DOMAIN=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Email — APP_PUBLIC_URL is used in verification/reset links
APP_PUBLIC_URL=http://localhost:5173

# Provider: smtp (real inbox), brevo, resend, ethereal (fake inbox only), or auto
EMAIL_PROVIDER=smtp

# SMTP — Gmail example (delivers to any inbox; no third-party signup)
# 1) Google Account → Security → 2-Step Verification ON
# 2) App passwords → create "Mail" → paste 16-char password below (no spaces)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=TZW Fire Safety <you@gmail.com>

# Brevo (sends to any recipient after sender verification)
# https://www.brevo.com → SMTP & API → generate key, verify sender email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=TZW Fire Safety

# Resend (optional fallback — onboarding@resend.dev only delivers to your Resend account email)
EMAIL_FROM=TZW Fire Safety <onboarding@resend.dev>
RESEND_API_KEY=
